generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  password     String
  name         String?
  lastname     String?
  role         String   @default("user")
  bio          String?
  location     String?
  website      String?
  socialLinks  Json?    @map("social_links")
  profileImage String?  @map("profile_image")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  createdProjects Project[]         @relation("CreatedProjects")
  projects        ProjectsOnUsers[]
  tasks           TasksOnUsers[]
  auditLogs       AuditLog[]
  sessions        ActiveSession[]
  announcements   Announcement[]
  
  roleId          Int?     @map("role_id")
  roleRel         Role?    @relation(fields: [roleId], references: [id])

  @@map("users")
  @@index([roleId])
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  creatorId   Int      @map("creator_id")
  color       String   @default("indigo")
  icon        String   @default("Folder")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  creator User              @relation("CreatedProjects", fields: [creatorId], references: [id])
  users   ProjectsOnUsers[]
  tasks   Task[]

  @@map("projects")
  @@index([creatorId])
}

model ProjectsOnUsers {
  projectId Int @map("project_id")
  userId    Int @map("user_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("projects_users")
  @@index([userId])
  @@index([projectId])
}

model Task {
  id          Int       @id @default(autoincrement())
  description String
  projectId   Int?      @map("project_id")
  statusId    Int?      @map("status_id")
  priority    String? // 'high', 'medium', 'low'
  dueDate     DateTime? @map("due_date")
  completed   Boolean   @default(false)
  deleted     Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  project Project?      @relation(fields: [projectId], references: [id])
  status  TaskStatus?   @relation(fields: [statusId], references: [id])
  users   TasksOnUsers[]
  tags    TasksOnTags[]

  @@map("tasks")
  @@index([projectId])
  @@index([statusId])
  @@index([deleted])
}

model TasksOnUsers {
  taskId Int @map("task_id")
  userId Int @map("user_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("tasks_users")
  @@index([userId])
  @@index([taskId])
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String   @default("blue")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tasks TasksOnTags[]

  @@map("tags")
}

model TasksOnTags {
  taskId Int @map("task_id")
  tagId  Int @map("tag_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("tasks_tags")
  @@index([tagId])
  @@index([taskId])
}

model TaskStatus {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tasks Task[]

  @@map("task_statuses")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
  @@index([userId])
  @@index([entityType, entityId])
}

// --- NEW ADMIN FEATURES MODELS ---

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique // 'admin', 'manager', 'user', 'auditor'
  description String?
  isSystem    Boolean          @default(false) @map("is_system") // If true, cannot be deleted
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  action      String           // e.g. 'create', 'read', 'update', 'delete', 'manage'
  resource    String           // e.g. 'task', 'project', 'user', 'system'
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")

  roles       RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model SystemSetting {
  key         String   @id
  value       String   // JSON stringified value
  description String?
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_settings")
}

model ActiveSession {
  id           String   @id @default(uuid())
  userId       Int      @map("user_id")
  tokenHash    String   @unique // Store hash of token to verify/revoke
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  deviceType   String?  @map("device_type") // 'mobile', 'desktop', 'tablet'
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("active_sessions")
  @@index([userId])
}

model Webhook {
  id          Int      @id @default(autoincrement())
  name        String
  url         String
  events      String[] // Array of event names: 'task.created', 'user.login'
  secret      String?  // For signing payloads
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("webhooks")
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  message     String
  type        String   @default("info") // info, warning, error, success
  isActive    Boolean  @default(true) @map("is_active")
  startsAt    DateTime @default(now()) @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   Int?     @map("created_by")

  creator     User?    @relation(fields: [createdBy], references: [id])

  @@map("announcements")
}
